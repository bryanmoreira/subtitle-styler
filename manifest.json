{
  "manifest_version": 3,
  "name": "Subtitle Styler",
  "version": "1.0.1",
  "description": "Aumente e personalize as legendas (tamanho, cor e borda) na Netflix, YouTube, Prime Video, Disney+, Max, Globoplay e outros streamings.",
  "permissions": ["storage"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Ajustar legenda",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_start"
    }
  ]
}
